ul Response","content":{"application/json":{"schema":{}}}}}}},"/call/twilio/recording-callback":{"post":{"tags":["Calls"],"summary":"Twilio Recording Callback","description":"Receives the finished-recording notification from Twilio (fired by the\n`recordingStatusCallback` set on the <Dial> verb in the TwiML above).\n\nTwilio sends: CallSid, RecordingSid, RecordingUrl, RecordingStatus,\nRecordingDuration. We store RecordingUrl against the CallLog row matching\nCallSid; the audio itself is streamed to the frontend later via the\nauthenticated /call/logs/{id}/recording proxy (Twilio media requires auth).","operationId":"twilio_recording_callback_call_twilio_recording_callback_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/call/start/{contact_id}":{"post":{"tags":["Calls"],"summary":"Start Call Route","description":"Start a single outbound call to a contact.","operationId":"start_call_route_call_start__contact_id__post","security":[{"OAuth2PasswordBearer":[]}],"parameters":[{"name":"contact_id","in":"path","required":true,"schema":{"type":"string","title":"Contact Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/call/twilio/status":{"get":{"tags":["Calls"],"summary":"Twilio Status","description":"Check whether Twilio credentials are configured and valid.","operationId":"twilio_status_call_twilio_status_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}},"security":[{"OAuth2PasswordBearer":[]}]}},"/call/log":{"post":{"tags":["Calls"],"summary":"Create Call Log","operationId":"create_call_log_call_log_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CallLogCreate"}}},"required":true},"responses":{"200":{"descriptio